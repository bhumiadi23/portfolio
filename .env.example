# EmailJS Configuration for Annuva's Apology Decision Notification
# Obtain these from your free account at https://dashboard.emailjs.com/

# 1. Email Service ID (e.g. service_gmail or service_xxxx)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id

# 2. Email Template ID (e.g. template_xxxx)
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# 3. EmailJS Public Key (Account > API Keys > Public Key)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
